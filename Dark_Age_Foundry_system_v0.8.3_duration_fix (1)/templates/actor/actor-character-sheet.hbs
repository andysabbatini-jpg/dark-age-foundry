<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100" />
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'BPNB_BORG.UI.Name'}}" /></h1>
      {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
      use both the "grid" and "grid-Ncol" class where "N" can be any number
      from 1 to 12 and will create that number of columns. --}}
      <div class="resources grid grid-3col">

        {{!-- "flex-group-center" is also defined in the _grid.scss file
        and it will add a small amount of padding, a border, and will
        center all of its child elements content and text. --}}
        <div class="resource flex-group-center">
          <label for="system.health.value" class="resource-label">{{localize 'BPNB_BORG.UI.Health'}}</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.health.value" value="{{system.health.value}}" data-dtype="Number" />
            <span> / </span>
            <input type="text" name="system.health.max" value="{{system.health.max}}" data-dtype="Number" />
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.devils_luck.value" class="resource-label">{{localize 'BPNB_BORG.UI.DevilsLuck'}}</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.power.value" value="{{system.power.value}}" data-dtype="Number" />
            <span> / </span>
            <input type="text" name="system.power.max" value="{{system.power.max}}" data-dtype="Number" />
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.attributes.spell_cast_amount.value" class="resource-label">{{localize 'BPNB_BORG.UI.SpellsPerDay'}}</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.spell_cast_amount.value" value="{{system.spell_cast_amount.value}}"
              data-dtype="Number" />
            <span> / </span>
            <input type="text" name="system.spell_cast_amount.max" value="{{system.spell_cast_amount.max}}"
              data-dtype="Number" />
          </div>
        </div>

      </div>
      <div class="resources grid grid-5col">



        <div class="resource flex-group-center">
          <label for="system.class_name" class="resource-label">{{localize 'BPNB_BORG.UI.Class'}}</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.class_name" value="{{system.class_name}}" data-dtype="String" />
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.subclass_name" class="resource-label">{{localize 'BPNB_BORG.UI.Subclass'}}</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.subclass_name" value="{{system.subclass_name}}" data-dtype="String" />
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.attributes.level.value" class="resource-label">{{localize 'BPNB_BORG.UI.Gold'}}</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.attributes.gp.value" value="{{system.attributes.gp.value}}"
              data-dtype="Number" />
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.attributes.level.value" class="resource-label">{{localize 'BPNB_BORG.UI.Level'}}</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.attributes.level.value" value="{{system.attributes.level.value}}"
              data-dtype="Number" />
          </div>
        </div>

        <div class="resource flex-group-center">
          <label for="system.attributes.level.value" class="resource-label">{{localize 'BPNB_BORG.UI.Madness'}}</label>
          <div class="resource-content flexrow flex-center flex-between">
            <input type="text" name="system.madness" value="{{system.madness}}"
              data-dtype="Number" />
          </div>
        </div>
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    <a class="item tab-header" data-tab="features">{{localize 'BPNB_BORG.UI.Main'}}</a>
    <a class="item tab-header" data-tab="description">{{localize 'BPNB_BORG.UI.Description'}}</a>
    <a class="item tab-header" data-tab="spells">{{localize 'BPNB_BORG.UI.Spells'}}</a>
    <a class="item tab-header" data-tab="events">{{localize 'BPNB_BORG.UI.Events'}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Owned Features Tab --}}
    <div class="tab features" data-group="primary" data-tab="features">
      <section class="grid grid-3col">
        <aside class="sidebar">

          {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
          use both the "grid" and "grid-Ncol" class where "N" can be any number
          from 1 to 12 and will create that number of columns. --}}
          <div class="abilities flexcol">
            {{#each system.abilities as |ability key|}}
            <div class="ability flexrow flex-group-center">
              <label for="system.abilities.{{key}}.value" class="resource-label rollable flexlarge align-left"
                data-roll="d20+{{ability.value}}" data-label="{{ability.label}}">{{ability.label}}</label>
              <input type="text" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number" />
            </div>
            {{/each}}
          </div>
        </aside>

        {{!-- For the main features list, span the right two columns --}}
        <section class="main grid-span-2">
          {{!-- This is a Handlebars partial. They're stored in the `/parts` folder next to this sheet, and defined in
          module/helpers/templates.mjs --}}
          {{> "systems/bpnb-borg/templates/actor/parts/actor-features.hbs"}}
        </section>

      </section>

      <section class="grid grid-3col">
        <div class="flex-group-center"><button id="action_short_rest" class="quick_action_button">{{localize 'BPNB_BORG.UI.ShortRest'}}</button></div>
        <div class="flex-group-center"><button id="action_long_rest" class="quick_action_button">{{localize 'BPNB_BORG.UI.LongRest'}}</button></div>
        <div class="flex-group-center"><button id="action_defend" class="quick_action_button">{{localize 'BPNB_BORG.UI.Defend'}}</button></div>
      </section>
      <section>
        <h3 class="section-header"><strong>{{localize 'BPNB_BORG.UI.Weapons'}}</strong></h3>
        {{> "systems/bpnb-borg/templates/actor/parts/actor-weapons.hbs"}}
      </section>
      <section>
        <h3 class="section-header"><strong>{{localize 'BPNB_BORG.UI.Armour'}}</strong></h3>
        {{> "systems/bpnb-borg/templates/actor/parts/actor-armour.hbs"}}
      </section>
      <section>
        <h3 class="section-header"><strong>{{localize 'BPNB_BORG.UI.Items'}}</strong></h3>
        {{> "systems/bpnb-borg/templates/actor/parts/actor-items.hbs"}}
      </section>
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      {{!-- If you want TinyMCE editors to output inline rolls when rendered, you need to pass the actor's roll data to
      the rollData property. --}}
      {{editor system.biography target="system.biography" rollData=rollData button=true owner=owner editable=editable}}
    </div>

    {{!-- Owned Spells Tab --}}
    <div class="tab spells" data-group="primary" data-tab="spells">
      {{> "systems/bpnb-borg/templates/actor/parts/actor-spells.hbs"}}
    </div>

    {{!-- Narrative archive; Active Effects remain available on items and in the system API. --}}
    <div class="tab events flexcol" data-group="primary" data-tab="events">
      {{> "systems/bpnb-borg/templates/actor/parts/actor-events.hbs"}}
    </div>

  </section>
</form>

