<ol class='items-list'>
    <li class='item flexrow items-header'>
        <div class='item-name'>{{localize 'BPNB_BORG.UI.Name'}}</div>
        <div class='item-prop'>{{localize 'BPNB_BORG.UI.Tier'}}</div>
        <div class='item-formula'>{{localize 'BPNB_BORG.UI.Dice'}}</div>
        <div class='item-controls'>
            <a class='item-control item-create' title='{{localize "DOCUMENT.Create" type=(localize 'TYPES.Item.armour')}}'
                data-type='armour'>
                <i class='fas fa-plus'></i>
                {{localize 'DOCUMENT.New' type=(localize 'TYPES.Item.armour')}}
            </a>
        </div>
    </li>
    {{#each armour as |item id|}}
    <li class='item flexrow' data-item-id='{{item._id}}'>
        <div class='item-name'>
            <div class='item-image post-item-description' data-item-id='{{item._id}}'>
                <a class='rollable' data-roll-type='item'>
                    <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' />
                </a>
            </div>
            <h4>
                {{item.name}}
            </h4>
        </div>
        <div class="item-prop">
            {{item.system.level}}
        </div>
        <div class='item-formula'>
            <span class="rollable" data-roll="{{item.system.dice}}" data-label="Armour roll for {{item.name}}">
            {{item.system.dice}}
            </span>
        </div>
        <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize 'TYPES.Item.armour')}}'>
                <i class='fas fa-edit'></i>
            </a>
            <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize 'TYPES.Item.armour')}}'>
                <i class='fas fa-trash'></i>
            </a>
        </div>
    </li>
    {{/each}}
</ol>